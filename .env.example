# 复制本文件为 .env 并填入你的 DeepSeek API key（.env 已被 .gitignore 忽略）
# Copy this file to .env and fill in your DeepSeek API key (.env is gitignored).

# 必填：DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：自定义 OpenAI 兼容端点（默认 https://api.deepseek.com）
# DeepSeek 官方端点不需要 /v1；第三方端点若要求 /v1，请写进 base URL。
RS_AGENT_BASE_URL=https://api.deepseek.com

# 可选：模型 id（默认 deepseek-flash；可选 deepseek-v4-pro）
RS_AGENT_MODEL=deepseek-flash

# 可选：线格式，chat 或 responses（默认 chat）
RS_AGENT_API=chat

# 可选：思考模式与强度（默认 disabled；写了强度但不写 enabled 时自动启用思考）
# RS_AGENT_THINKING=enabled
# RS_AGENT_REASONING_EFFORT=low

# 说明：
# 1. 优先级：命令行参数 > 档案 > 环境变量 > .env > 内置默认值。
# 2. 协议 / 模型 / 思考强度也可以在交互模式下通过启动菜单选择（--no-menu 跳过）。
# 3. 也可以在终端里 export DEEPSEEK_API_KEY=... 代替 .env，效果相同。
# 4. 不要把真实 key 提交到仓库；.env 只在本地读取。
# 5. 多套配置可在交互会话里用 /save <name> 保存、/use <name> 切换，
#    档案存于 .rs_agent_profiles.json（已 gitignore，只记录 key 的环境变量名）。
